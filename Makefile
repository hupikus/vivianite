	-$(am__rm_f) src/$(am__dirstamp)
	-$(am__rm_f) src/dl/$(DEPDIR)/$(am__dirstamp)
	-$(am__rm_f) src/dl/$(am__dirstamp)
	-$(am__rm_f) src/input/$(DEPDIR)/$(am__dirstamp)
	-$(am__rm_f) src/input/$(am__dirstamp)
	-$(am__rm_f) src/render/$(DEPDIR)/$(am__dirstamp)
	-$(am__rm_f) src/render/$(am__dirstamp)
	-$(am__rm_f) src/res/$(DEPDIR)/$(am__dirstamp)
